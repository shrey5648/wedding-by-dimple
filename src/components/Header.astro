---
const nav = [
  { href: "/", label: "Home" },
  { href: "/real-stories", label: "Real Stories" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/films", label: "Films" },
  { href: "/about", label: "About Us" },
  { href: "/services", label: "Services" },
  { href: "/faq", label: "FAQ" },
];
const path = Astro.url.pathname;
---

<header id="site-header" class="absolute inset-x-0 top-0 z-40 transition-all duration-300">
  <div class="header-inner mx-auto flex max-w-7xl items-center justify-between px-6 py-6 md:px-10">
    <a href="/" class="font-display text-xl tracking-wide text-ivory">
      Wedding <span class="text-marigold-light">by</span> Dimple
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-sm uppercase tracking-[0.14em] transition-colors",
              path === item.href
                ? "text-marigold-light"
                : "text-ivory/80 hover:text-ivory",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="rounded-full border border-marigold-light/70 px-5 py-2 text-sm uppercase tracking-[0.14em] text-ivory transition-colors hover:bg-marigold-light hover:text-ink"
      >
        Contact
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="text-ivory md:hidden cursor-pointer"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg width="26" height="18" viewBox="0 0 26 18" fill="none">
        <path d="M0 1H26" stroke="currentColor" stroke-width="1.5"></path>
        <path d="M0 9H26" stroke="currentColor" stroke-width="1.5"></path>
        <path d="M0 17H26" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    class="hidden flex-col gap-1 bg-ink/95 backdrop-blur-md px-6 pb-6 md:hidden transition-all duration-300 ease-out opacity-0 -translate-y-4"
  >
    {
      nav.concat([{ href: "/contact", label: "Contact" }]).map((item) => (
        <a
          href={item.href}
          class="border-b border-ivory/10 py-3 text-sm uppercase tracking-[0.14em] text-ivory/90"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const setupHeader = () => {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-nav");
    
    // Toggle mobile navigation with smooth fade-slide transition
    toggle?.addEventListener("click", () => {
      const isHidden = menu?.classList.contains("hidden");
      if (isHidden) {
        menu?.classList.remove("hidden");
        menu?.classList.add("flex");
        // Trigger reflow to apply transition
        void menu?.offsetWidth;
        menu?.classList.remove("opacity-0", "-translate-y-4");
      } else {
        menu?.classList.add("opacity-0", "-translate-y-4");
        const onTransitionEnd = (e: TransitionEvent) => {
          if (e.propertyName === "opacity" && menu?.classList.contains("opacity-0")) {
            menu?.classList.add("hidden");
            menu?.classList.remove("flex");
            menu?.removeEventListener("transitionend", onTransitionEnd);
          }
        };
        menu?.addEventListener("transitionend", onTransitionEnd);
      }
      toggle.setAttribute("aria-expanded", String(!!isHidden));
    });

    // Sticky header class trigger on scroll
    const header = document.getElementById("site-header");
    const handleScroll = () => {
      if (window.scrollY > 40) {
        header?.classList.add("sticky-header", "scrolled");
        header?.classList.remove("absolute");
      } else {
        header?.classList.remove("sticky-header", "scrolled");
        header?.classList.add("absolute");
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll(); // Initial load check
  };

  // Bind to page loads and view transitions
  setupHeader();
  document.addEventListener("astro:after-swap", setupHeader);
</script>
