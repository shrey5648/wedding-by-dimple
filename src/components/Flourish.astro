---
interface Props {
  color?: string;
  class?: string;
}
const { color = "var(--color-marigold)", class: className = "" } = Astro.props;
---

<svg
  class={`flourish mx-auto h-8 w-40 ${className}`}
  viewBox="0 0 240 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    d="M2 16 C 30 4, 45 28, 70 16 C 95 4, 110 28, 120 16 C 130 4, 145 28, 170 16 C 195 4, 210 28, 238 16"
    stroke={color}
    stroke-width="1.5"
    stroke-linecap="round"
  ></path>
  <circle cx="120" cy="16" r="2.5" fill={color}></circle>
</svg>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.6 }
  );
  document.querySelectorAll(".flourish").forEach((el) => observer.observe(el));
</script>
