---
import { Image } from "astro:assets";
import hero1 from "../assets/hero1.jpg";
import hero2 from "../assets/hero2.jpg";
import hero3 from "../assets/hero3.jpg";
import hero4 from "../assets/hero4.jpg";
import hero5 from "../assets/hero5.jpg";

const slides = [
  {
    image: hero1,
    alt: "Bride and groom sharing an intimate, candid moment",
    caption: "Capturing Love · Dimple & Shrey"
  },
  {
    image: hero2,
    alt: "Couple standing back-to-back by the lake",
    caption: "Quiet Moments · Riverfront Pre-wedding"
  },
  {
    image: hero3,
    alt: "Bride in red traditional lehenga leaning on a wall",
    caption: "Timeless Grace · Traditional Bridal Portrait"
  },
  {
    image: hero4,
    alt: "Bride and groom in ivory/white hugging in a garden",
    caption: "Serene Hugs · Garden Wedding Ceremony"
  },
  {
    image: hero5,
    alt: "Bride in red traditional lehenga standing under a large tree",
    caption: "Grand Beginnings · Forest Wedding Shoot"
  }
];
---

<section class="relative flex min-h-[92vh] items-end overflow-hidden bg-ink" id="hero-slider">
  <!-- Slides Container -->
  <div class="absolute inset-0 h-full w-full">
    {
      slides.map((slide, index) => (
        <div
          class={`hero-slide absolute inset-0 h-full w-full opacity-0 transition-all duration-[1200ms] ease-in-out ${index === 0 ? "active opacity-100 z-10" : "z-0"}`}
          data-index={index}
        >
          <Image
            src={slide.image}
            alt={slide.alt}
            width={1800}
            height={1200}
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "low"}
            class="absolute inset-0 h-full w-full object-cover opacity-75"
          />
          <div class="absolute bottom-8 right-8 z-25 hidden md:block text-xs uppercase tracking-[0.2em] text-ivory/60 transition-opacity duration-300 font-body">
            {slide.caption}
          </div>
        </div>
      ))
    }
  </div>

  <!-- Background Vignette/Gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-ink/20 z-15 pointer-events-none"></div>

  <!-- Slider Controls (Navigation Arrows) -->
  <button
    id="prev-slide"
    class="group absolute left-6 top-1/2 z-30 -translate-y-1/2 rounded-full border border-ivory/20 bg-ink/10 p-3 text-ivory backdrop-blur-sm transition-all duration-300 hover:border-ivory hover:bg-ink/50 hover:scale-105 active:scale-95 opacity-0 focus:opacity-100 cursor-pointer"
    aria-label="Previous Slide"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
  </button>
  <button
    id="next-slide"
    class="group absolute right-6 top-1/2 z-30 -translate-y-1/2 rounded-full border border-ivory/20 bg-ink/10 p-3 text-ivory backdrop-blur-sm transition-all duration-300 hover:border-ivory hover:bg-ink/50 hover:scale-105 active:scale-95 opacity-0 focus:opacity-100 cursor-pointer"
    aria-label="Next Slide"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </button>

  <!-- Static Brand overlay text -->
  <div class="relative z-20 mx-auto max-w-4xl px-6 pb-24 pt-40 text-center md:px-10">
    <p class="mb-5 text-xs uppercase tracking-[0.3em] text-marigold-light reveal-on-scroll">
      Wedding Photography &amp; Films · India
    </p>
    <h1 class="font-display text-4xl leading-[1.1] text-ivory sm:text-5xl md:text-6xl reveal-on-scroll reveal-delay-100">
      <span class="word-mask"><span class="word-item">Capturing</span></span>
      <span class="word-mask"><span class="word-item text-marigold-light">Love.</span></span>
      <br />
      <span class="word-mask"><span class="word-item">Preserving</span></span>
      <span class="word-mask"><span class="word-item text-marigold-light">Forever.</span></span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-balance text-ivory/80 reveal-on-scroll reveal-delay-200">
      We don't just capture weddings. We preserve emotions forever.
    </p>
    <p class="mx-auto mt-3 max-w-md font-display text-lg italic text-ivory/60 reveal-on-scroll reveal-delay-300">
      "We arrive as your photographers, but we leave as a part of your family."
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4 reveal-on-scroll reveal-delay-400">
      <a
        href="/portfolio"
        class="magnetic-btn rounded-full bg-marigold-light px-7 py-3 text-sm uppercase tracking-[0.14em] text-ink transition hover:bg-ivory hover:scale-105 duration-300"
      >
        View Portfolio
      </a>
      <a
        href="/contact"
        class="magnetic-btn rounded-full border border-ivory/40 px-7 py-3 text-sm uppercase tracking-[0.14em] text-ivory transition hover:border-ivory hover:scale-105 duration-300"
      >
        Enquire Now
      </a>
    </div>
  </div>

  <!-- Bottom Slide Progress & Indicators -->
  <div class="absolute bottom-8 left-1/2 z-20 flex -translate-x-1/2 items-center gap-4">
    {
      slides.map((_, index) => (
        <button
          class="slide-indicator relative h-1 w-8 overflow-hidden rounded-full bg-ivory/25 transition-all duration-300 hover:bg-ivory/40 cursor-pointer"
          data-index={index}
          aria-label={`Go to slide ${index + 1}`}
        >
          <span class="slide-progress absolute left-0 top-0 h-full w-0 bg-marigold-light transition-all duration-[6000ms] linear" />
        </button>
      ))
    }
  </div>
</section>

<style>
  /* Local styling to handle custom animation behavior */
  #hero-slider:hover #prev-slide,
  #hero-slider:hover #next-slide {
    opacity: 1;
  }
  
  .hero-slide {
    will-change: opacity, transform;
  }
  
  /* Ken Burns transition details */
  .hero-slide.active img {
    animation: kenburns-slide 20s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }
  
  @keyframes kenburns-slide {
    0% {
      transform: scale(1.03);
    }
    100% {
      transform: scale(1.1);
    }
  }

  .slide-progress.running {
    width: 100%;
  }
</style>

<script>
  const setupSlider = () => {
    const slider = document.getElementById("hero-slider");
    if (!slider) return;

    const slides = slider.querySelectorAll(".hero-slide");
    const indicators = slider.querySelectorAll(".slide-indicator");
    const nextBtn = document.getElementById("next-slide");
    const prevBtn = document.getElementById("prev-slide");

    let currentIndex = 0;
    const slideDuration = 6000; // 6s per slide
    let slideInterval: number | undefined;

    const showSlide = (index: number) => {
      if (index === currentIndex) return;

      // Handle wrapping
      let nextIndex = index;
      if (nextIndex >= slides.length) nextIndex = 0;
      if (nextIndex < 0) nextIndex = slides.length - 1;

      const currentSlide = slides[currentIndex];
      const nextSlide = slides[nextIndex];

      // Remove active states
      currentSlide.classList.remove("active", "opacity-100", "z-10");
      currentSlide.classList.add("opacity-0", "z-0");

      nextSlide.classList.add("active", "opacity-100", "z-10");
      nextSlide.classList.remove("opacity-0", "z-0");

      // Update indicators
      indicators.forEach((indicator, idx) => {
        const progress = indicator.querySelector(".slide-progress");
        if (!progress) return;

        progress.classList.remove("running");
        // Force reflow
        void (progress as HTMLElement).offsetWidth;

        if (idx === nextIndex) {
          progress.classList.add("running");
        }
      });

      currentIndex = nextIndex;
    };

    const nextSlide = () => {
      showSlide(currentIndex + 1);
    };

    const prevSlide = () => {
      showSlide(currentIndex - 1);
    };

    // Auto rotation with progress bar
    const startRotation = () => {
      stopRotation();
      
      // Start the progress animation for current slide
      const activeIndicator = indicators[currentIndex];
      if (activeIndicator) {
        const progress = activeIndicator.querySelector(".slide-progress");
        if (progress) {
          progress.classList.add("running");
        }
      }

      slideInterval = window.setInterval(nextSlide, slideDuration);
    };

    const stopRotation = () => {
      if (slideInterval) {
        clearInterval(slideInterval);
        slideInterval = undefined;
      }
      indicators.forEach((indicator) => {
        const progress = indicator.querySelector(".slide-progress");
        progress?.classList.remove("running");
      });
    };

    // Event listeners
    nextBtn?.addEventListener("click", () => {
      nextSlide();
      startRotation(); // Reset timer on click
    });

    prevBtn?.addEventListener("click", () => {
      prevSlide();
      startRotation(); // Reset timer on click
    });

    indicators.forEach((indicator, idx) => {
      indicator.addEventListener("click", () => {
        showSlide(idx);
        startRotation(); // Reset timer on click
      });
    });

    // Start
    startRotation();

    // Clean up interval when component is destroyed (Astro page swap)
    return () => {
      stopRotation();
    };
  };

  // Bind to page loads and view transitions
  let cleanupSlider = setupSlider();
  document.addEventListener("astro:after-swap", () => {
    if (cleanupSlider) cleanupSlider();
    cleanupSlider = setupSlider();
  });
</script>
