---
import Layout from "../layouts/Layout.astro";
import Flourish from "../components/Flourish.astro";
import HeroSlider from "../components/HeroSlider.astro";
import { Image } from "astro:assets";
import story1 from "../assets/Home/DSC03735.JPG";
import story2 from "../assets/Home/DSC05806.JPG";
import teaserVideo from "../assets/Home/teaser_1.mp4";

const whyChooseUs = [
  "Emotion First",
  "Candid & Traditional Photography",
  "Cinematic Wedding Films",
  "Drone Coverage",
  "Creative Portrait Sessions",
  "Premium Album Design",
  "Professional Editing",
  "Fast Delivery",
  "Experienced Professional Team",
  "Natural Colour Grading",
  "Personalized Client Experience",
  "100% Client Satisfaction",
];

const process = [
  { n: "01", title: "Consultation", copy: "We understand your vision and requirements." },
  { n: "02", title: "Planning", copy: "We prepare every detail before your event." },
  { n: "03", title: "Capture", copy: "Every emotion, ritual, smile, and celebration is documented naturally." },
  { n: "04", title: "Editing", copy: "Each photograph and film is professionally edited with attention to colour, emotion, and storytelling." },
  { n: "05", title: "Delivery", copy: "Albums, films and memories delivered with care." },
];

const numbers = [
  { value: "500+", label: "Weddings Captured", target: 500, suffix: "+" },
  { value: "1000+", label: "Happy Families", target: 1000, suffix: "+" },
  { value: "8+", label: "Years Experience", target: 8, suffix: "+" },
  { value: "Pan India", label: "Available Across India", target: null, suffix: "" },
];

const testimonials = [
  "The photographs brought tears to our eyes. Every emotion was captured beautifully.",
  "Professional team, amazing creativity, and unforgettable memories.",
  "The cinematic film felt like a movie of our love story.",
  "The cinematic film was beyond anything we imagined. Every family member loved it.",
  "Our wedding film still gives us goosebumps every time we watch it.",
];
---

<Layout
  title="Home"
  description="Wedding by Dimple — candid and cinematic wedding photography and films, available across India."
>
  <HeroSlider />

  <!-- Real Stories teaser -->
  <section class="px-6 py-24 md:px-10 overflow-hidden">
    <div class="mx-auto max-w-6xl">
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div class="reveal-on-scroll">
          <p class="mb-3 text-xs uppercase tracking-[0.3em] text-wine">Real Stories</p>
          <h2 class="font-display text-3xl leading-tight sm:text-4xl">
            Every smile, every tear, every ritual — remembered.
          </h2>
          <p class="mt-5 max-w-md leading-relaxed text-ink/70">
            We create timeless wedding photographs and cinematic films that
            tell your story exactly as it happened.
          </p>
          <a
            href="/real-stories"
            class="mt-6 inline-block border-b border-wine text-sm uppercase tracking-[0.14em] text-wine hover:text-wine-light hover:border-wine-light transition-colors"
          >
            Read Real Stories &rarr;
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <Image
            src={story1}
            alt="Wedding ritual candid moment"
            class="h-full w-full rounded-sm object-cover reveal-on-scroll"
            loading="lazy"
            width={500}
            height={650}
          />
          <Image
            src={story2}
            alt="Couple laughing candidly"
            class="mt-8 h-full w-full rounded-sm object-cover reveal-on-scroll reveal-delay-200"
            loading="lazy"
            width={500}
            height={400}
          />
        </div>
      </div>
    </div>
  </section>

  <div class="py-4"><Flourish /></div>

  <!-- Films -->
  <section class="bg-ink px-6 py-24 text-ivory md:px-10 overflow-hidden">
    <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
      <video
        src={teaserVideo}
        autoplay
        loop
        muted
        playsinline
        class="aspect-video w-full rounded-sm object-cover reveal-on-scroll"
      ></video>
      <div class="reveal-on-scroll reveal-delay-200">
        <p class="mb-3 text-xs uppercase tracking-[0.3em] text-marigold-light">Films</p>
        <h2 class="font-display text-3xl leading-tight sm:text-4xl">
          Relive Your Wedding Through Cinema
        </h2>
        <p class="mt-5 max-w-md leading-relaxed text-ivory/75">
          Our cinematic wedding films combine storytelling, music, and
          artistic visuals to create memories you'll treasure forever. From
          intimate ceremonies to grand celebrations, every detail is captured
          with creativity, elegance, and authenticity.
        </p>
        <p class="mt-4 max-w-md font-display italic text-ivory/60">
          At Wedding by Dimple, every frame is captured with heart, passion,
          and purpose.
        </p>
        <a
          href="/films"
          class="mt-6 inline-block border-b border-marigold-light text-sm uppercase tracking-[0.14em] text-marigold-light hover:text-white hover:border-white transition-colors"
        >
          Watch Our Films &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="px-6 py-24 md:px-10 overflow-hidden">
    <div class="mx-auto max-w-6xl">
      <p class="mb-3 text-center text-xs uppercase tracking-[0.3em] text-wine reveal-on-scroll">Why Choose Us</p>
      <h2 class="mx-auto max-w-2xl text-center font-display text-3xl leading-tight sm:text-4xl reveal-on-scroll reveal-delay-100">
        Twelve reasons couples trust us with their day
      </h2>

      <ul class="mt-14 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 md:grid-cols-4">
        {
          whyChooseUs.map((item, index) => (
            <li class={`reveal-on-scroll border-t border-ink/10 pt-4 text-sm leading-snug text-ink/80 reveal-delay-${(index % 4) * 150 + 100}`}>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Our Process — numbered because it's a real, ordered sequence -->
  <section class="bg-blush px-6 py-24 md:px-10 overflow-hidden">
    <div class="mx-auto max-w-6xl">
      <p class="mb-3 text-xs uppercase tracking-[0.3em] text-wine reveal-on-scroll">Our Process</p>
      <h2 class="max-w-xl font-display text-3xl leading-tight sm:text-4xl reveal-on-scroll reveal-delay-100">
        From first conversation to final delivery
      </h2>

      <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
        {
          process.map((step, index) => (
            <li class={`reveal-on-scroll reveal-delay-${index * 150 + 100}`}>
              <span class="font-display text-3xl text-marigold">{step.n}</span>
              <p class="mt-3 font-display text-lg">{step.title}</p>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{step.copy}</p>
            </li>
          ))
        }
      </ol>

      <p class="mx-auto mt-16 max-w-xl text-center font-display text-xl italic leading-snug reveal-on-scroll">
        "We believe photographs should make you feel something — years from
        today, exactly as you lived it."
      </p>
    </div>
  </section>

  <!-- Numbers -->
  <section id="stats-section" class="bg-ink px-6 py-20 text-ivory md:px-10">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-10 text-center md:grid-cols-4 reveal-on-scroll">
      {
        numbers.map((n) => (
          <div>
            <p
              class="font-display text-4xl text-marigold-light sm:text-5xl stat-value"
              data-target={n.target}
              data-suffix={n.suffix}
            >
              {n.value}
            </p>
            <p class="mt-2 text-xs uppercase tracking-[0.14em] text-ivory/60">{n.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Testimonials -->
  <section class="px-6 py-24 md:px-10 overflow-hidden">
    <div class="mx-auto max-w-4xl text-center">
      <p class="mb-3 text-xs uppercase tracking-[0.3em] text-wine reveal-on-scroll">Testimonials</p>
      <h2 class="font-display text-3xl leading-tight sm:text-4xl reveal-on-scroll reveal-delay-100">In their words</h2>

      <div class="mt-14 grid gap-10 sm:grid-cols-2">
        {
          testimonials.slice(0, 4).map((t, index) => (
            <blockquote class={`reveal-on-scroll text-left reveal-delay-${(index % 2) * 200 + 100}`}>
              <p class="text-marigold">★★★★★</p>
              <p class="mt-3 leading-relaxed text-ink/80">"{t}"</p>
            </blockquote>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden bg-wine px-6 py-28 text-center text-ivory md:px-10 reveal-on-scroll">
    <h2 class="mx-auto max-w-xl font-display text-3xl leading-tight sm:text-4xl">
      Let's create something beautiful together.
    </h2>
    <p class="mx-auto mt-4 max-w-md text-ivory/75">
      Your wedding deserves more than photographs. It deserves a story that
      lasts forever.
    </p>
    <a
      href="/contact"
      class="mt-8 inline-block rounded-full bg-marigold-light px-8 py-3 text-sm uppercase tracking-[0.14em] text-ink transition hover:bg-ivory hover:scale-105 duration-300"
    >
      Start the Conversation
    </a>
  </section>
</Layout>

<script>
  const setupStatsCounter = () => {
    const statsSection = document.getElementById("stats-section");
    if (!statsSection) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const elements = entry.target.querySelectorAll(".stat-value");
            elements.forEach((el) => {
              const targetAttr = el.getAttribute("data-target");
              if (!targetAttr) return;

              const target = parseInt(targetAttr, 10);
              const suffix = el.getAttribute("data-suffix") || "";
              let start = 0;
              const duration = 2000; // ms
              const startTime = performance.now();

              const updateCount = (now: number) => {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                
                // Ease out quad
                const ease = progress * (2 - progress);
                const currentVal = Math.floor(ease * target);
                
                el.textContent = `${currentVal}${suffix}`;

                if (progress < 1) {
                  requestAnimationFrame(updateCount);
                } else {
                  el.textContent = `${target}${suffix}`;
                }
              };

              requestAnimationFrame(updateCount);
            });
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    observer.observe(statsSection);
  };

  // Bind count-up script to layout loading events
  setupStatsCounter();
  document.addEventListener("astro:after-swap", setupStatsCounter);
</script>
