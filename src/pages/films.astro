---
import Layout from "../layouts/Layout.astro";

const films = [
  { title: "Riya & Kunal", place: "Udaipur", seed: "film-1" },
  { title: "Sneha & Aarav", place: "Ahmedabad", seed: "film-2" },
  { title: "Priya & Dev", place: "Goa", seed: "film-3" },
  { title: "Meera & Rohan", place: "Jaipur", seed: "film-4" },
];
---

<Layout
  title="Films"
  description="Cinematic wedding films by Wedding by Dimple — storytelling, music, and artistic visuals."
>
  <section class="bg-ink px-6 pb-16 pt-40 text-center text-ivory md:px-10">
    <p class="mb-3 text-xs uppercase tracking-[0.3em] text-marigold-light">Films</p>
    <h1 class="mx-auto max-w-2xl font-display text-4xl leading-tight sm:text-5xl">
      Relive Your Wedding Through Cinema
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-ivory/75">
      We believe that every wedding is unique. Our cinematic wedding films
      combine storytelling, music, and artistic visuals to create memories
      you'll treasure forever.
    </p>
  </section>

  <section class="px-6 py-20 md:px-10">
    <div class="mx-auto grid max-w-6xl gap-10 sm:grid-cols-2">
      {
        films.map((film) => (
          <a href="#" class="group block">
            <div class="relative aspect-video overflow-hidden rounded-sm bg-ink">
              <img
                src={`https://picsum.photos/seed/${film.seed}/800/450`}
                alt={`Wedding film still — ${film.title}`}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
                width="800"
                height="450"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-ink/30 transition group-hover:bg-ink/40">
                <span class="flex h-14 w-14 items-center justify-center rounded-full bg-ivory/90 text-ink">
                  ▶
                </span>
              </div>
            </div>
            <p class="mt-3 font-display text-lg">{film.title}</p>
            <p class="text-sm text-ink/60">{film.place}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="bg-wine px-6 py-24 text-center text-ivory md:px-10">
    <p class="mx-auto max-w-xl font-display text-2xl italic leading-snug">
      "At Wedding by Dimple, every frame is captured with heart, passion, and
      purpose. Because your memories deserve to last forever."
    </p>
    <a
      href="/contact"
      class="mt-8 inline-block rounded-full bg-marigold-light px-8 py-3 text-sm uppercase tracking-[0.14em] text-ink transition hover:bg-ivory"
    >
      Book Your Film
    </a>
  </section>
</Layout>
