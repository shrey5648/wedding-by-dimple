---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import svcWedding from "../assets/Portfolio/wedding/DSC07451.JPG";
import svcFilms from "../assets/Portfolio/wedding/DSC07464.JPG";
import svcPreWedding from "../assets/Portfolio/Prewedding/DSC03963 - Copy.JPG";
import svcEngagement from "../assets/Portfolio/Engagement/DSC01548.JPG";
import svcHaldi from "../assets/Portfolio/Haldi & Mahendi/DSC05464.JPG";
import svcMehendi from "../assets/Portfolio/Haldi & Mahendi/DSC05259.JPG";
import svcSangeet from "../assets/Portfolio/Haldi & Mahendi/DSC05473.JPG";
import svcBridal from "../assets/Portfolio/Portraits/DSC03772.JPG";
import svcCouple from "../assets/Portfolio/Portraits/DSC04048.JPG";
import svcBabyShower from "../assets/Service/Baby shower/_DIM0763.JPG";
import svcMaternity from "../assets/Service/Maternity/02 copy.jpg";
import svcFamily from "../assets/Service/Family Event/SWF_6876.JPG";

const services = [
  { title: "Wedding Photography", copy: "Elegant storytelling through timeless photographs that preserve every emotion of your wedding day.", image: svcWedding },
  { title: "Cinematic Wedding Films", copy: "Beautiful storytelling with cinematic visuals and emotional music.", image: svcFilms },
  { title: "Pre Wedding", copy: "Celebrate your journey together with creative concepts and stunning outdoor or destination shoots.", image: svcPreWedding },
  { title: "Engagement", copy: "Elegant coverage for your special beginning.", image: svcEngagement },
  { title: "Haldi & Mehendi", copy: "Colourful moments, joyful traditions, and candid laughter captured naturally.", image: svcHaldi },
  { title: "Mehendi Ceremony", copy: "Every intricate detail, every smile, and every celebration documented naturally.", image: svcMehendi },
  { title: "Sangeet & Musical Night", copy: "Energetic performances, dancing, and unforgettable celebrations preserved forever.", image: svcSangeet },
  { title: "Bridal Portraits", copy: "Grace, elegance, confidence, and timeless beauty in every frame.", image: svcBridal },
  { title: "Couple Portrait Session", copy: "Romantic portraits that reflect your love, connection, and personalities.", image: svcCouple },
  { title: "Baby Shower", copy: "Celebrating the beginning of a beautiful journey.", image: svcBabyShower },
  { title: "Maternity Photography", copy: "Capturing the beauty of motherhood.", image: svcMaternity },
  { title: "Family Events", copy: "Birthday, Anniversary, Naming Ceremony and all special occasions.", image: svcFamily },
];
---

<Layout
  title="Services"
  description="Wedding photography, cinematic films, pre-wedding shoots, and more — services offered by Wedding by Dimple."
>
  <section class="bg-ink px-6 pb-16 pt-40 text-center text-ivory md:px-10">
    <p class="mb-3 text-xs uppercase tracking-[0.3em] text-marigold-light reveal-on-scroll">Our Services</p>
    <h1 class="mx-auto max-w-2xl font-display text-4xl leading-tight sm:text-5xl reveal-on-scroll reveal-delay-100">
      Coverage for every moment of your celebration
    </h1>
  </section>

  <section class="px-6 py-20 md:px-10 overflow-hidden">
    <div class="mx-auto grid max-w-6xl gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s, index) => (
          <div class={`reveal-on-scroll reveal-delay-${(index % 3) * 150 + 100} group`}>
            <div class="overflow-hidden rounded-sm">
              <Image
                src={s.image}
                alt={s.title}
                class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                width={600}
                height={440}
              />
            </div>
            <p class="mt-4 font-display text-xl text-ink font-medium">{s.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink/70">{s.copy}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-blush px-6 py-20 text-center md:px-10 reveal-on-scroll">
    <h2 class="font-display text-3xl">Not sure which package fits your day?</h2>
    <p class="mx-auto mt-3 max-w-md text-ink/70">
      Every wedding is unique — we build packages around your requirements.
    </p>
    <a
      href="/contact"
      class="mt-6 inline-block rounded-full bg-wine px-8 py-3 text-sm uppercase tracking-[0.14em] text-ivory transition hover:bg-ink hover:scale-105 duration-300"
    >
      Talk to Us
    </a>
  </section>
</Layout>
